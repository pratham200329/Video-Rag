# ==========================================
# VideoRAG AI Environment Configuration
# ==========================================

# Groq API Key (Required)
# Generate your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model ID (Optional - defaults to openai/gpt-oss-20b)
# Supported options: openai/gpt-oss-20b, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-20b

# Whisper model size for audio transcription (Optional - default: base)
# Use 'tiny' (~75 MB) on memory-constrained hosts (e.g. Render free tier, 512 MB RAM).
# Options (approx. RAM in subprocess): tiny ~75 MB | base ~139 MB | small ~461 MB | medium ~1.5 GB | large ~2.9 GB
# Set this as an environment variable in your hosting provider's dashboard, NOT in .env files.
WHISPER_MODEL=tiny
